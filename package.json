{
	"name": "s32webdav",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev --port 8080",
		"debug": "wrangler dev  --inspector-port  9229 --port 8080",
		"start": "wrangler dev",
		"test": "vitest",
		"test:remote:finder": "node scripts/finder-remote-e2e.mjs",
		"test:remote:folder-move": "node scripts/folder-move-remote-e2e.mjs",
		"dev:d1": "wrangler dev --config wrangler.d1.jsonc --port 8080",
		"deploy:d1": "wrangler deploy --config wrangler.d1.jsonc",
		"test:d1": "vitest run --config vitest.d1.config.mjs",
		"db:migrate:d1": "wrangler d1 migrations apply DB --config wrangler.d1.jsonc"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.15.1",
		"@cloudflare/workers-types": "^4.20260430.1",
		"@vitest/runner": "4.1.5",
		"@vitest/snapshot": "4.1.5",
		"typescript": "^5.7.2",
		"vitest": "~4.1.5",
		"wrangler": "^4.86.0"
	}
}
